# Путь к локальному хранилищу Obsidian Vault
OBSIDIAN_VAULT_PATH=C:\Users\denis\Documents\Obsidian Vault

# Рабочая директория скриптов записи и транскрибации
RECORDING_WORKSPACE=C:\Users\denis\Documents\antigravity\recording

# Модель Faster-Whisper по умолчанию (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small

# Устройство для вычислений (cuda / cpu)
WHISPER_DEVICE=cuda

# Тип вычислений для CUDA (float16, int8_float16, float32)
WHISPER_COMPUTE_TYPE=float16
