import os
import sys
import json
import re

sys.stdout.reconfigure(encoding='utf-8')

vault_dir = r"C:\Users\denis\Documents\Obsidian Vault"
math_dir = os.path.join(vault_dir, "Математика Матанализ")
terms_dir = os.path.join(math_dir, "Термины")
canvas_file = os.path.join(math_dir, "Математика.canvas")
textbook_file = os.path.join(math_dir, "Учебник - Математика.md")
registry_file = r"C:\Users\denis\Documents\antigravity\recording\PROCESSED_VIDEOS.md"

errors = []

print("=== 1. Проверка существования файлов заметок ===")
expected_files = [
    "МатАн - Лекция 1. Элементы теории множеств и числовые последовательности.md",
    "МатАн - Практика 1. Построение графиков функций.md",
    "МатАн - Практика 2. Графики функций и множества.md",
    "МатАн - Практика 3 и 4. Последовательности и пределы.md",
    "Учебник - Математика.md",
    "Математика.canvas"
]
for ef in expected_files:
    p = os.path.join(math_dir, ef)
    if os.path.exists(p):
        print(f" [OK] {ef}")
    else:
        errors.append(f"Файл не найден: {p}")
        print(f" [ERR] {ef}")

print("\n=== 2. Проверка связей во всех терминах Zettelkasten ===")
for tf in sorted(os.listdir(terms_dir)):
    if not tf.endswith('.md'):
        continue
    p = os.path.join(terms_dir, tf)
    with open(p, 'r', encoding='utf-8') as f:
        content = f.read()
    
    # Ищем блок Связи
    m = re.search(r'\*\*Связи:\*\*\s*\[\[([^\]]+)\]\]', content)
    if not m:
        errors.append(f"В термине {tf} не найден блок **Связи:**")
