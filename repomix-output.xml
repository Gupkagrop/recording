import os
import json
from pathlib import Path

vault = Path("C:/Users/denis/Documents/Obsidian Vault/Информационные технологии и сервисы")

renames = {}
for f in vault.iterdir():
    if f.is_file() and f.suffix == '.md' and not f.name.startswith("Учебник"):
        if not f.name.startswith("ИТиС - ") and (f.name.startswith("Практика") or f.name.startswith("Лекция")):
            old_name = f.stem
            new_name = "ИТиС - " + old_name
            renames[old_name] = new_name

print(f"Plan to rename: {list(renames.keys())}")

# 1. Update text files (terms, textbook, etc.)
for root, dirs, files in os.walk(vault):
    for file in files:
        if file.endswith('.md'):
            fpath = Path(root) / file
            with open(fpath, 'r', encoding='utf-8') as f:
                content = f.read()
            
            changed = False
            for old, new in renames.items():
                if f"[[{old}]]" in content:
                    content = content.replace(f"[[{old}]]", f"[[{new}]]")
                    changed = True
                if f"[[{old}|" in content:
                    content = content.replace(f"[[{old}|", f"[[{new}|")
                    changed = True
            
            if changed:
                with open(fpath, 'w', encoding='utf-8') as f:
                    f.write(content)
                print(f"Updated links in: {fpath.name}")

# 2. Update Canvas
canvas_file = vault / "Информационные технологии и сервисы.canvas"
if canvas_file.exists():
    with open(canvas_file, 'r', encoding='utf-8') as f:
        canvas_data = json.load(f)
    
    changed = False
    for node in canvas_data.get('nodes', []):
        if node.get('type') == 'file':
            file_val = node.get('file', '')
            for old, new in renames.items():
                if file_val == f"{old}.md":
                    node['file'] = f"{new}.md"
                    changed = True
                elif file_val == f"Информационные технологии и сервисы/{old}.md":
                    node['file'] = f"Информационные технологии и сервисы/{new}.md"
                    changed = True
                    
    if changed:
        with open(canvas_file, 'w', encoding='utf-8') as f:
            json.dump(canvas_data, f, ensure_ascii=False, indent=2)
        print(f"Updated Canvas links")

# 3. Rename files
for old, new in renames.items():
    old_path = vault / f"{old}.md"
    new_path = vault / f"{new}.md"
    if old_path.exists():
        old_path.rename(new_path)
        print(f"Renamed file: {old_path.name} -> {new_path.name}")
