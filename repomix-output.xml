with open(canvas_file, 'w', encoding='utf-8') as f:
    json.dump(canvas_data, f, ensure_ascii=False, indent=2)
print(f"Холст Canvas успешно сохранен ({nodes_updated} узлов обновлено).")

print("\n=== Шаг 6: Обновление реестра PROCESSED_VIDEOS.md ===")
with open(registry_file, 'r', encoding='utf-8') as f:
    reg_content = f.read()

# Обновление названий заметок
for old_name, new_name in renames.items():
    reg_content = reg_content.replace(f"- **Заметка:** {old_name}", f"- **Заметка:** {new_name}")

# Обновление заголовка дисциплины до полного стандарта
