for old_link, new_link in link_map.items():
    tb_content = tb_content.replace(f"[[{old_link}]]", f"[[{new_link}]]")

with open(textbook_file, 'w', encoding='utf-8') as f:
    f.write(tb_content)
print(f"Учебник {os.path.basename(textbook_file)} успешно обновлен.")

print("\n=== Шаг 5: Обновление интерактивного холста Canvas ===")
with open(canvas_file, 'r', encoding='utf-8') as f:
    canvas_data = json.load(f)

nodes_updated = 0
for node in canvas_data.get('nodes', []):
    if node.get('type') == 'file':
