print("Все 4 исходных файла найдены.")

print("\n=== Шаг 2: Чтение, очистка и переименование заметок ===")
for old_name, new_name in renames.items():
    old_path = os.path.join(math_dir, old_name)
    new_path = os.path.join(math_dir, new_name)
    
    with open(old_path, 'r', encoding='utf-8') as f:
        content = f.read()
    
    # Очистка синтаксиса в Лекции 1
    if old_name == "Лекция 1.md":
        content = content.replace("-![[Математика Матанализ/Термины/Пустое множество]]]", "- ![[Пустое множество]]")
        content = content.replace("-![[Математика Матанализ/Термины/Универсальное множество]]]", "- ![[Универсальное множество]]")
    
    # Гармонизация заголовка в Практике 2
    if old_name == "Практика 2.md":
        content = content.replace("# Практика 2\n", "# Практика 2. Графики функций и множества\n")
    
    with open(new_path, 'w', encoding='utf-8') as f:
        f.write(content)
    
    os.remove(old_path)
    print(f"Переименован: {old_name} -> {new_name}")

print("\n=== Шаг 3: Обновление ссылок в терминах Zettelkasten ===")
updated_terms_count = 0
for term_file in sorted(os.listdir(terms_dir)):
    if not term_file.endswith('.md'):
        continue
    term_path = os.path.join(terms_dir, term_file)
    with open(term_path, 'r', encoding='utf-8') as f:
        term_content = f.read()
    
    original = term_content
    # Замена ссылок с учетом возможных путей и скобок
    # 1. Лекция 1
    term_content = re.sub(
        r'\[\[(?:Математика Матанализ/)?Лекция 1\]+\]*',
        f'[[{link_map["Лекция 1"]}]]',
        term_content
    )
    # 2. Практика 1
    term_content = re.sub(
        r'\[\[(?:Математика Матанализ/)?Практика 1\]+\]*',
        f'[[{link_map["Практика 1"]}]]',
        term_content
    )
    # 3. Практика 2
    term_content = re.sub(
        r'\[\[(?:Математика Матанализ/)?Практика 2\]+\]*',
        f'[[{link_map["Практика 2"]}]]',
        term_content
    )
    # 4. Практика 3 и 4
    term_content = re.sub(
        r'\[\[(?:Математика Матанализ/)?Практика 3 и 4\]+\]*',
        f'[[{link_map["Практика 3 и 4"]}]]',
        term_content
    )
    # Форматирование строки Связи
    term_content = re.sub(r'\*\*Связи:\*\*\s*(\[\[[^\]]+\]\])', r'**Связи:** \1', term_content)

    if term_content != original:
        with open(term_path, 'w', encoding='utf-8') as f:
            f.write(term_content)
        updated_terms_count += 1
        print(f"Обновлен термин: {term_file}")

print(f"Всего обновлено терминов: {updated_terms_count} из {len(os.listdir(terms_dir))}")

print("\n=== Шаг 4: Обновление генерального учебника ===")
with open(textbook_file, 'r', encoding='utf-8') as f:
