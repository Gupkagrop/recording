        if os.path.exists(target_path):
            print(f" [OK] {tf} -> [[{target}]]")
        else:
            errors.append(f"В термине {tf} битая ссылка: [[{target}]]")
            print(f" [ERR] {tf} -> битая ссылка [[{target}]]")

print("\n=== 3. Проверка ссылок в Учебник - Математика.md ===")
with open(textbook_file, 'r', encoding='utf-8') as f:
    tb_content = f.read()

# Проверяем все [[...]] ссылки в учебнике
wikilinks = re.findall(r'\[\[([^\]|]+)(?:\|[^\]]+)?\]\]', tb_content)
for wl in wikilinks:
    wl_clean = wl.strip()
    # Проверяем, существует ли заметка в math_dir или в terms_dir
    p_note = os.path.join(math_dir, f"{wl_clean}.md")
    p_term = os.path.join(terms_dir, f"{wl_clean}.md")
    if os.path.exists(p_note) or os.path.exists(p_term):
        print(f" [OK] Учебник -> [[{wl_clean}]]")
    else:
        errors.append(f"В Учебнике битая ссылка: [[{wl_clean}]]")
        print(f" [ERR] Учебник -> битая ссылка [[{wl_clean}]]")

print("\n=== 4. Проверка узлов холста Canvas ===")
with open(canvas_file, 'r', encoding='utf-8') as f:
    cv_data = json.load(f)

for node in cv_data.get('nodes', []):
    if node.get('type') == 'file':
        f_rel = node.get('file', '')
        f_abs = os.path.join(vault_dir, f_rel)
        if os.path.exists(f_abs):
            print(f" [OK] Canvas узел: {f_rel}")
        else:
            errors.append(f"В Canvas битый узел: {f_rel}")
            print(f" [ERR] Canvas узел: {f_rel}")

print("\n=== 5. Проверка реестра PROCESSED_VIDEOS.md ===")
with open(registry_file, 'r', encoding='utf-8') as f:
    reg_content = f.read()

for ef in expected_files:
    if ef.startswith("МатАн"):
        if ef in reg_content:
            print(f" [OK] PROCESSED_VIDEOS содержит {ef}")
        else:
            errors.append(f"PROCESSED_VIDEOS не содержит {ef}")
            print(f" [ERR] PROCESSED_VIDEOS не содержит {ef}")

# Проверяем отсутствие старых названий в секции Математика
math_sec_m = re.search(r'### Математика \(Матанализ\)(.*?)(?=\n### |\Z)', reg_content, re.DOTALL)
if math_sec_m:
    math_sec = math_sec_m.group(1)
    for old in ["Практика 1.md", "Практика 2.md", "Лекция 1.md", "Практика 3 и 4.md"]:
        if f"- **Заметка:** {old}" in math_sec:
            errors.append(f"В секции Математика осталось старое имя: {old}")
else:
    errors.append("Не найдена секция ### Математика (Матанализ) в PROCESSED_VIDEOS.md")

print("\n===============================")
if errors:
    print(f"ОБНАРУЖЕНО ОШИБОК: {len(errors)}")
    for err in errors:
        print(" -", err)
    sys.exit(1)
else:
    print("ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ УСПЕШНО! НИ ОДНОЙ БИТОЙ ССЫЛКИ!")
