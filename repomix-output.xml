math_dir = os.path.join(vault_dir, "Математика Матанализ")
terms_dir = os.path.join(math_dir, "Термины")
canvas_file = os.path.join(math_dir, "Математика.canvas")
textbook_file = os.path.join(math_dir, "Учебник - Математика.md")
registry_file = r"C:\Users\denis\Documents\antigravity\recording\PROCESSED_VIDEOS.md"

renames = {
    "Лекция 1.md": "МатАн - Лекция 1. Элементы теории множеств и числовые последовательности.md",
    "Практика 1.md": "МатАн - Практика 1. Построение графиков функций.md",
    "Практика 2.md": "МатАн - Практика 2. Графики функций и множества.md",
    "Практика 3 и 4.md": "МатАн - Практика 3 и 4. Последовательности и пределы.md"
}

link_map = {
    "Лекция 1": "МатАн - Лекция 1. Элементы теории множеств и числовые последовательности",
    "Практика 1": "МатАн - Практика 1. Построение графиков функций",
    "Практика 2": "МатАн - Практика 2. Графики функций и множества",
    "Практика 3 и 4": "МатАн - Практика 3 и 4. Последовательности и пределы"
}

print("=== Шаг 1: Проверка существования файлов ===")
for old_name, new_name in renames.items():
    old_path = os.path.join(math_dir, old_name)
    new_path = os.path.join(math_dir, new_name)
    if not os.path.exists(old_path):
