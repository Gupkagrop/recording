reg_content = reg_content.replace("| Математика | 4 |", "| Математика (Матанализ) | 4 |")

with open(registry_file, 'w', encoding='utf-8') as f:
    f.write(reg_content)
print("Реестр PROCESSED_VIDEOS.md успешно обновлен.")

print("\n=== МИГРАЦИЯ УСПЕШНО ЗАВЕРШЕНА ===")
